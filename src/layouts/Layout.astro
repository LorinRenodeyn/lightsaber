---
import '../styles/global.css';
import { isOnPath } from '../utils';

interface Props {
	hideNav?: boolean;
}
const { hideNav } = Astro.props;

const links = [
	{ href: '/', label: 'Home' },
	{ href: '/terms-and-concepts', label: 'Terms & Concepts' },
	{ href: '/postures', label: 'Postures' },
	{ href: '/defence', label: 'Defence' },
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width">
		<link rel="icon" type="image/svg+xml" href="/favicon.svg">
		<link rel="icon" href="/favicon.ico">
		<meta name="generator" content={Astro.generator}>
		<title>Lightsaber Holocron | De Hallebardiers</title>
		<link rel="sitemap" href="/sitemap-index.xml">
	</head>
	<body
		class="bg-neutral-950 min-h-screen flex flex-col grow-1 text-white items-center overflow-auto"
	>
		<nav
			class="bg-linear-to-b from-70% from-neutral-950 to-transparent transition-all duration-300 inert:opacity-0 z-1 sticky top-0 mb-10 md:py-3 px-5 w-full flex justify-center"
			inert={hideNav}
		>
			<ul
				class="flex justify-center flex-wrap gap-3 md:gap-4 max-w-[80ch] px-5"
			>
				{links.map((link) => {
					const isCurrent = isOnPath(Astro.url.pathname, link.href);
					return (
						<li>
							<a
								class="block px-3 md:py-3 text-shadow-hallebardiers-bright/40 hover:text-shadow-lg aria-current:italic aria-current:text-shadow-hallebardiers/40 aria-current:text-hallebardiers-bright aria-current:text-shadow-lg navlink"
								href={link.href}
								aria-current={isCurrent}
							>
								{link.label}
							</a>
						</li>
					);
				})}
			</ul>
		</nav>
		<main class="max-w-[80ch] grow-1 px-5 pb-5">
			<slot />
		</main>
	</body>
</html>

<style>
	@import "tailwindcss";

	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}

	main {
		view-transition-name: content;
	}

	.navlink {
		position: relative;

		&::after {
			content: "";
			transform: scaleX(0);
			@apply block mt-1 bottom-0 left-0 bg-(--hallebardiers-accent) h-[2px] w-full origin-center transition-all duration-300;
		}
		&:hover {
			&:not([aria-current="true"]) {
				@apply text-(--hallebardiers-accent);
			}
			&::after {
				transform: scaleX(1);
			}
		}
	}
</style>
