---
import Breadcrumbs from '@components/Breadcrumbs.astro';
import '../styles/global.css';
import { isOnPath } from '../utils';

interface Props {
	hideNav?: boolean;
	showBreadCrumbs?: boolean;
	frontmatter?: any;
}
let { hideNav, showBreadCrumbs, frontmatter } = Astro.props;
hideNav = hideNav ?? frontmatter?.hideNav;
showBreadCrumbs = showBreadCrumbs ?? frontmatter?.showBreadCrumbs;

const links = [
	{ href: '/', label: 'Home' },
	{ href: '/terms-and-concepts', label: 'Terms & Concepts' },
	{ href: '/postures', label: 'Postures' },
	{ href: '/defence', label: 'Defence' },
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width">
		<link rel="icon" type="image/svg+xml" href="/favicon.svg">
		<link rel="icon" href="/favicon.ico">
		<meta name="generator" content={Astro.generator}>
		<title>Lightsaber Holocron | De Hallebardiers</title>
		<link rel="sitemap" href="/sitemap-index.xml">
	</head>
	<body
		class="bg-neutral-950 min-h-screen flex flex-col grow-1 text-white items-center overflow-auto"
	>
		<!-- bg-linear-to-b from-70% from-neutral-950 to-transparent transition-all duration-300 inert:opacity-0 z-1 sticky top-0 mb-10 pt-3 md:py-3 px-5 w-full flex justify-center -->
		<nav
			class="inert:opacity-0 z-1 sticky top-0 md:pt-3 bg-neutral-950 w-full max-w-[80ch]"
			inert={hideNav}
		>
			<!-- flex justify-center flex-wrap gap-3 md:gap-4 max-w-[80ch] px-5 -->
			<ul class="flex justify-stretch w-full gap-2">
				{links.map((link) => {
					const isCurrent = isOnPath(Astro.url.pathname, link.href);
					return (
						<li class="grow-1">
							{/* block text-center px-3 md:py-2 text-shadow-hallebardiers-bright/40 hover:text-shadow-lg aria-current:italic aria-current:text-shadow-hallebardiers/40 aria-current:text-hallebardiers-bright aria-current:text-shadow-lg navlink inset-shadow-md shadow-hallebardiers-bright/40*/}
							<a
								class="transition-all duration-300 h-full rounded-sm flex flex-col justify-center border border-hallebardiers italic text-center px-4 pt-2 pb-4 text-hallebardiers-bright bg-neutral-950 shadow-hallebardiers-bright/40 inset-shadow-hallebardiers-bright/60 [--custom-shadow:_0_-4px_12px_var(--tw-inset-shadow-color,_#0000000d)] hover-focus:inset-shadow-(--custom-shadow)  aria-current:inset-shadow-(--custom-shadow) aria-current:not-italic text-shadow-hallebardiers-bright/40 aria-current:text-shadow-lg aria-current:text-hallebardiers-accent aria-current:not-focus:brightness-150 hover-focus:brightness-250 focus:outline-none focus:shadow-md"
								href={link.href}
								aria-current={isCurrent}
							>
								{link.label}
							</a>
						</li>
					);
				})}
			</ul>
		</nav>
		<main class="max-w-[80ch] grow-1 px-5 pb-5">
			{showBreadCrumbs && <Breadcrumbs />}
			<slot />
		</main>
	</body>
</html>

<style>
	@import "tailwindcss";

	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}

	main {
		view-transition-name: content;
	}

	.navlink {
		position: relative;

		&::after {
			content: "";
			transform: scaleX(0);
			@apply block mt-1 bottom-0 left-0 bg-(--hallebardiers-accent) h-[2px] w-full origin-center transition-all duration-300;
		}
		&:hover,
		&:focus {
			&:not([aria-current="true"]) {
				@apply text-(--hallebardiers-accent);
			}
			&::after {
				transform: scaleX(1);
			}
		}
	}
</style>
