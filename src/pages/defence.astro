---
import DefenceCard from '@components/DefenceCard.astro';
import Lightsaber from '@components/Lightsaber.astro';
import Layout from '@layouts/Layout.astro';
import { ArrowDown, ArrowDownLeft, ArrowDownRight } from '@lucide/astro';
---

<Layout>
	<h1>Defence</h1>

	<p>
		The main goal:
		<span class="text-hallebardiers glow uppercase ml-[1ch]">
			Do not get hit.</span
		>
	</p>

	<h2 class="mt-5">Types of defence</h2>
	<ul class="mb-5">
		<li>Defence by moving away</li>
		<li>Defence without advantage</li>
		<li>Defence with advantage</li>
		<li>Defence by breaking the attack</li>
		<li>Master Strike: defend and hit at the same time</li>
	</ul>

	<h2>Blade clash directions</h2>
	<p class="italic">
		Lightsaber blades are bouncy when hitting something, so the relative
		directions when parrying are extra-important
	</p>
	<ul class="list-none gap-5 grid md:grid-cols-2 mt-4">
		<DefenceCard
			title="Right angle"
			description="Good: stops a strike head-on"
			rating="good"
			bladeColor="var(--color-green-600)"
		>
			<ArrowDown class="scale-200 text-red-400 glow" />
			<Lightsaber />
		</DefenceCard>
		<DefenceCard
			title="Toward point (defender viewpoint)"
			description="Good: the opponent's blade will slide toward the point and away from yours hands"
			rating="good"
			bladeColor="var(--color-green-600)"
			contentClass="origin-center rotate-20 my-10"
		>
			<ArrowDownRight class="scale-200 text-red-400 glow" />
			<Lightsaber />
		</DefenceCard>
		<DefenceCard
			title="Toward handle (defender standpoint)"
			description="Bad: the opponent's blade will slide toward your hilt, hitting
				your hands"
			rating="bad"
			contentClass="origin-center -rotate-20 my-10"
		>
			<ArrowDownLeft class="scale-200 text-red-400 glow" />
			<Lightsaber />
		</DefenceCard>
	</ul>
</Layout>
