---
import { Check, X } from '@lucide/astro';
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<h1>Defence</h1>

	<p>
		The main goal:
		<span class="text-hallebardiers-accent uppercase ml-[1ch]">
			Do not get hit.</span
		>
	</p>

	<h2 class="mt-5">Types of defence</h2>
	<ul class="mb-5">
		<li>Defence by moving away</li>
		<li>Defence without advantage</li>
		<li>Defence with advantage</li>
		<li>Defence by breaking the attack</li>
		<li>Master Strike: defend and hit at the same time</li>
	</ul>

	<h2>Blade clash directions</h2>
	<ul class="list-none flex gap-3 justify-around mt-4">
		<li class="card">
			<p class="font-bold mb-3">Right angle</p>
			<p class="flex gap-2 text-sm items-center">
				<Check stroke-width={4} class="text-green-400" width={32} />
				Good: stops a strike head-on
			</p>
		</li>
		<li class="card">
			<p class="font-bold mb-3">Toward point (defender viewpoint)</p>
			<p class="flex gap-2 text-sm items-center">
				<Check stroke-width={4} class="text-green-400" width={32} />
				Good: the opponent's blade will slide toward the point
			</p>
		</li>
		<li class="card">
			<p class="font-bold mb-3">Toward handle (defender standpoint)</p>
			<p class="flex gap-2 text-sm items-center">
				<X class="text-red-400" stroke-width={4} width={32} />
				Bad: the opponent's blade will slide toward your hilt, hitting
				your hands
			</p>
		</li>
	</ul>
</Layout>
