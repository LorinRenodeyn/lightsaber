---
import { containsPartial, toSlug } from '@utils';
import type { GetStaticPaths, ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import { type CollectionEntry, getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export const getStaticPaths = (async () => {
	const postures = await getCollection('posture');

	return postures.map((posture: CollectionEntry<'posture'>) => ({
		params: { slug: toSlug(posture.data.title) },
		props: posture,
	}));
}) satisfies GetStaticPaths;
type Props = CollectionEntry<'posture'>;
const posture = Astro.props;
const imageSlug = toSlug(posture.data.title ?? '');
const { Content } = await render(posture);
const images = import.meta.glob<{ default: ImageMetadata }>(
	`/src/assets/*.{jpeg,jpg,png,gif}`,
);
const imageKey = Object.keys(images).find((key) =>
	containsPartial(imageSlug, key),
);
---

<Layout showBreadCrumbs>
	<h1>{posture.data.title}</h1>
	<Content />
	{imageKey && images[imageKey] ? (
		<Picture
			src={images[imageKey]()}
			alt={`Visual representation of the ${posture.data.title} posture by a battle droid`}
			densities={[1.5, 2]}
			formats={['avif', 'webp']}
			priority
			class="holo-filter max-h-[66vh]"
		/>
	) : (
		<p class="text-hallebardiers-accent italic text-sm">
			Image coming soon™...
		</p>
	)}
</Layout>
