---
import { Picture } from 'astro:assets';
import hallebardiersLogo from '../assets/Wapenschild.png';

const links = [
	{ href: '/terms-and-concepts', label: 'Terms & Concepts' },
	{ href: '/postures', label: 'Postures' },
	{ href: '/defence', label: 'Defence' },
];
---

<article
	class="flex h-full flex-col justify-evenly md:justify-center gap-[5vh]"
>
	<div class="text-center">
		<Picture
			class="inline-block h-[25vh] md:h-[15vh] min-h-42 glow opacity-50 object-contain"
			src={hallebardiersLogo}
			alt="Official Hallebardiers coat of arms"
			priority
			densities={[1.5, 2]}
			formats={['avif', 'webp']}
		/>
		<h1 class="glow mb-0 text-hallebardiers motion-safe:animate-pulse">
			Lightsaber Holocron
		</h1>
		<ul
			class="text-hallebardiers italic md:flex gap-5 text-lg glow justify-center"
		>
			<li>Don't get hit</li>
			<li>Hit your opponent</li>
			<li>Make it look good</li>
		</ul>
	</div>

	<div class="text-center">
		<h2>Welcome, Padawan, what would you like to learn about today?</h2>
		<nav>
			<ul class="list-none flex gap-5 justify-center">
				{links.map((link) => (
					<li>
						<a
							href={link.href}
							class="transition-all duration-300 block py-2 px-4 bg-hallebardiers/50 hover:text-black hover:shadow-lg shadow-hallebardiers-bright/50 hover:bg-hallebardiers-accent rounded-sm"
						>
							{link.label}
						</a>
					</li>
				))}
			</ul>
		</nav>
	</div>
</article>
