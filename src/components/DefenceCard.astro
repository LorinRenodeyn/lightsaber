---
import { Check, X } from '@lucide/astro';
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'li'> {
	rating: 'good' | 'bad';
	title: string;
	description: string;
	bladeColor?: string;
	contentClass?: string;
}
const {
	rating,
	title,
	description,
	bladeColor = 'var(--color-hallebardiers)',
	contentClass = '',
	...rest
} = Astro.props;

const slotClasses = ['flex flex-col items-center', contentClass].join(' ');
---

<li
	class="card flex flex-col gap-3 justify-between"
	style={{ '--blade-color': bladeColor }}
	{...rest}
>
	<p class="font-bold mb-3">{title}</p>
	<div class={slotClasses}>
		<slot />
	</div>
	<p class="flex gap-2 text-sm items-center">
		{rating === 'good' ? (
			<Check stroke-width={4} class="text-green-400" width={32} />
		) : (
			<X class="text-red-400" stroke-width={4} width={32} />
		)}
		{description}
	</p>
</li>
