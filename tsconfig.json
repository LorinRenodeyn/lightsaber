{
	"extends": "astro/tsconfigs/strict",
	"include": [
		".astro/types.d.ts",
		"**/*",
		"./worker-configuration.d.ts"
	],
	"exclude": [
		"dist"
	],
	"compilerOptions": {
		"paths": {
			"@layouts/*": [
				"./src/layouts/*"
			],
			"@components/*": [
				"./src/components/*"
			],
			"@utils": [
				"./src/utils"
			],
			"@utils/*": [
				"./src/utils/*"
			]
		}
	}
}
